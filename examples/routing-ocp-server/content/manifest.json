{
  "format_version": "0.1.0-draft.2",
  "id": "routing.example",
  "version": "1.0.0-draft.1",
  "profile": {
    "id": "routing.matrix.weighted",
    "version": "1.0.0-draft.1"
  },
  "api": {
    "id": "routing.matrix.api",
    "version": "1.0.0-draft.1",
    "input_schema": "input",
    "configuration_schema": "configuration",
    "result_schema": "result"
  },
  "schemas": {
    "input": {
      "type": "object",
      "properties": {
        "depot_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "distance_matrix": {
          "type": "object",
          "properties": {
            "node_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 65
            },
            "distances_m": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50000000
                },
                "minItems": 1,
                "maxItems": 65
              },
              "minItems": 1,
              "maxItems": 65
            }
          },
          "required": [
            "node_ids",
            "distances_m"
          ],
          "additionalProperties": false
        },
        "visits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "demand_kg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000000
              }
            },
            "required": [
              "id",
              "demand_kg"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "capacity_kg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000000
              }
            },
            "required": [
              "id",
              "capacity_kg"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "distance_model": {
          "enum": [
            "supplied_matrix",
            "haversine_sphere_6371008.8m_half_up"
          ]
        },
        "source_coordinates": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": [
                  "id",
                  "latitude",
                  "longitude"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 65
            }
          ]
        }
      },
      "required": [
        "depot_id",
        "distance_matrix",
        "visits",
        "vehicles",
        "distance_model",
        "source_coordinates"
      ],
      "additionalProperties": false,
      "description": "Canonical API input: explicit directed integer-metre matrix; depot return is included. All visits are mandatory. Integer kg demands/capacities. Time windows, road lookup, service time and driver hours are outside this profile. The matrix need not satisfy the triangle inequality."
    },
    "configuration": {
      "type": "object",
      "properties": {
        "objective": {
          "enum": [
            "distance",
            "weighted_cost"
          ]
        },
        "distance_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "vehicle_weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "time_limit_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 30
        }
      },
      "required": [
        "objective",
        "distance_weight",
        "vehicle_weight",
        "time_limit_seconds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "objective": {
                "const": "distance"
              }
            }
          },
          "then": {
            "properties": {
              "distance_weight": {
                "const": 1
              },
              "vehicle_weight": {
                "const": 0
              }
            }
          }
        }
      ],
      "description": "Weighted score = distance_weight (points/metre) * total_distance_m + vehicle_weight (points/active vehicle) * vehicles_used. Explicit integer coefficients; no implicit normalization. Distance objective requires weights 1 and 0."
    },
    "result": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vehicle_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "visits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "minItems": 1,
                "maxItems": 64
              },
              "distance_m": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3250000000
              },
              "load_kg": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000000
              }
            },
            "required": [
              "vehicle_id",
              "visits",
              "distance_m",
              "load_kg"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "metrics": {
          "type": "object",
          "properties": {
            "total_distance_m": {
              "type": "integer",
              "minimum": 0
            },
            "vehicles_used": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "weighted_cost": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "total_distance_m",
            "vehicles_used",
            "weighted_cost"
          ],
          "additionalProperties": false
        },
        "input_fingerprint": {
          "type": "object",
          "properties": {
            "encoding": {
              "const": "ocp-json-binary64/1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "encoding",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "routes",
        "metrics",
        "input_fingerprint"
      ],
      "additionalProperties": false
    }
  },
  "default_locale": "en",
  "localizations": {
    "en": {
      "title": "Routing OCP Server",
      "summary": "Connect your MCP host to a real local OR-Tools routing API. Prepare official CSV/Excel, solve capacity-constrained routes, independently check results, and compare explicit fleet, weight and time candidates."
    },
    "ko": {
      "title": "라우팅 OCP 서버",
      "summary": "MCP 호스트에서 실제 OR-Tools 라우팅 API를 사용합니다. 공식 CSV·Excel 준비, 용량 제약 경로 계산, 독립 검산, 차량 구성·가중치·시간 후보 비교를 지원합니다."
    }
  },
  "units": {
    "m": {
      "dimension": "length",
      "definition": "Integer metres from the canonical distance matrix"
    },
    "kg": {
      "dimension": "mass",
      "definition": "Integer kilograms"
    },
    "vehicle": {
      "dimension": "count",
      "definition": "A vehicle serving at least one visit"
    },
    "point": {
      "dimension": "score",
      "definition": "Declared weighted score; coefficients fix the meaning"
    }
  },
  "capabilities": {
    "objectives": [
      {
        "id": "distance",
        "definition": "Minimize total matrix distance",
        "unit": "m",
        "direction": "minimize",
        "role": "optimized"
      },
      {
        "id": "weighted_cost",
        "definition": "Weighted score = distance_weight (points/metre) * total_distance_m + vehicle_weight (points/active vehicle) * vehicles_used. Explicit integer coefficients; no implicit normalization. Distance objective requires weights 1 and 0.",
        "unit": "point",
        "direction": "minimize",
        "role": "optimized",
        "weight_binding": "vehicle_weight"
      }
    ],
    "constraints": [
      {
        "id": "visit_once",
        "definition": "Every declared visit exactly once",
        "unit": null,
        "kind": "hard",
        "role": "enforced"
      },
      {
        "id": "capacity",
        "definition": "Route demand at most assigned vehicle capacity",
        "unit": "kg",
        "kind": "hard",
        "role": "enforced"
      },
      {
        "id": "depot_return",
        "definition": "Every used route starts and ends at the declared depot",
        "unit": null,
        "kind": "hard",
        "role": "enforced"
      },
      {
        "id": "available_fleet",
        "definition": "Each declared vehicle serves at most one route",
        "unit": null,
        "kind": "hard",
        "role": "enforced"
      }
    ],
    "execution": {
      "mode": "sync",
      "cancel": false,
      "durable": false,
      "evaluate": true
    }
  },
  "configuration_defaults": {
    "objective": "weighted_cost",
    "distance_weight": 1,
    "vehicle_weight": 0,
    "time_limit_seconds": 2
  },
  "configuration_rules": [],
  "bindings": [
    {
      "id": "fleet",
      "target": "input",
      "pointer": "/vehicles",
      "operation": "select_by_id",
      "id_field": "id",
      "value_schema": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "minItems": 1,
        "maxItems": 16
      }
    },
    {
      "id": "vehicle_weight",
      "target": "configuration",
      "pointer": "/vehicle_weight",
      "operation": "replace",
      "value_schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      }
    },
    {
      "id": "time_limit",
      "target": "configuration",
      "pointer": "/time_limit_seconds",
      "operation": "replace",
      "value_schema": {
        "type": "number",
        "minimum": 0.001,
        "maximum": 30
      }
    },
    {
      "id": "objective_configuration",
      "target": "configuration",
      "pointer": "",
      "operation": "replace",
      "value_schema": {
        "type": "object",
        "properties": {
          "objective": {
            "enum": [
              "distance",
              "weighted_cost"
            ]
          },
          "distance_weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "vehicle_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "time_limit_seconds": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 30
          }
        },
        "required": [
          "objective",
          "distance_weight",
          "vehicle_weight",
          "time_limit_seconds"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "objective": {
                  "const": "distance"
                }
              }
            },
            "then": {
              "properties": {
                "distance_weight": {
                  "const": 1
                },
                "vehicle_weight": {
                  "const": 0
                }
              }
            }
          }
        ],
        "description": "Weighted score = distance_weight (points/metre) * total_distance_m + vehicle_weight (points/active vehicle) * vehicles_used. Explicit integer coefficients; no implicit normalization. Distance objective requires weights 1 and 0."
      }
    }
  ],
  "metrics": [
    {
      "id": "total_distance_m",
      "pointer": "/metrics/total_distance_m",
      "definition": "Sum of every used route's matrix arcs, including return to depot",
      "unit": "m",
      "value_type": "integer",
      "direction": "minimize",
      "comparison_basis": "invariant"
    },
    {
      "id": "vehicles_used",
      "pointer": "/metrics/vehicles_used",
      "definition": "Count of nonempty vehicle routes",
      "unit": "vehicle",
      "value_type": "integer",
      "direction": "minimize",
      "comparison_basis": "invariant"
    },
    {
      "id": "weighted_cost",
      "pointer": "/metrics/weighted_cost",
      "definition": "Configured weighted distance and active vehicle count",
      "unit": "point",
      "value_type": "integer",
      "direction": "minimize",
      "comparison_basis": "same_configuration"
    }
  ],
