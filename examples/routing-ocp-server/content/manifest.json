  "playbooks": [
    {
      "id": "fleet_candidates",
      "version": "1.0.0",
      "status": "executable",
      "localizations": {
        "en": {
          "title": "Compare actual vehicle sets",
          "summary": "Defaults are for the bundled synthetic example. Supply variables with existing vehicle IDs for your own input. No vehicles are invented or cloned."
        },
        "ko": {
          "title": "차량 구성 비교",
          "summary": "명시한 후보와 동일 기준의 지표를 비교합니다. 전역 최적을 증명하지 않습니다."
        }
      },
      "binding_ids": [
        "fleet"
      ],
      "metric_ids": [
        "total_distance_m",
        "vehicles_used",
        "weighted_cost"
      ],
      "preserve": [
        {
          "target": "input",
          "pointer": "/visits"
        },
        {
          "target": "input",
          "pointer": "/depot_id"
        },
        {
          "target": "input",
          "pointer": "/distance_matrix"
        },
        {
          "target": "input",
          "pointer": "/distance_model"
        }
      ],
      "recipe": {
        "kind": "independent_variations",
        "variables": [
          {
            "binding": "fleet",
            "values": [
              [
                "van_a",
                "van_b"
              ],
              [
                "truck"
              ]
            ]
          }
        ]
      },
      "budget": {
        "max_calls": 16,
        "timeout_seconds": 60,
        "concurrency": 2
      }
    },
    {
      "id": "vehicle_weights",
      "version": "1.0.0",
      "status": "executable",
      "localizations": {
        "en": {
          "title": "Compare distance versus vehicle penalties",
          "summary": "Use the weighted_cost objective. Rank by a chosen invariant metric; weighted costs with different coefficients are not ranked against each other."
        },
