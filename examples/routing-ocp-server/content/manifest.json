          "target": "/visits",
          "mode": "array",
          "key": "/id",
          "columns": [
            {
              "name": "id",
              "target": "/id",
              "type": "string"
            },
            {
              "name": "demand_kg",
              "target": "/demand_kg",
              "type": "integer"
            }
          ]
        },
        {
          "id": "vehicles",
          "source": "vehicles.csv",
          "target": "/vehicles",
          "mode": "array",
          "key": "/id",
          "columns": [
            {
              "name": "id",
              "target": "/id",
              "type": "string"
            },
            {
              "name": "capacity_kg",
              "target": "/capacity_kg",
              "type": "integer"
            }
          ]
        },
        {
          "id": "distances",
          "source": "distances.csv",
          "target": "/distances",
          "mode": "array",
          "columns": [
            {
              "name": "from_id",
