{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocp:knowledge:0.1.0-draft.1",
  "title": "Optional OCP Knowledge projection (draft)",
  "type": "object", "additionalProperties": false,
  "required": ["knowledge_version", "domain", "profile", "catalog_fingerprint", "default_locale", "localizations", "sections", "required_extensions"],
  "properties": {
    "knowledge_version": {"const": "0.1.0-draft.1"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 128},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "catalog_fingerprint": {"type": "object", "additionalProperties": false, "required": ["encoding", "sha256"], "properties": {"encoding": {"const": "ocp-json-binary64/1"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "default_locale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})*$"},
    "localizations": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})*$"},
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["title", "summary", "aliases"], "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "aliases": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }}
    },
    "sections": {"type": "object", "additionalProperties": false, "required": ["input", "objectives", "constraints", "interpretation"], "properties": {
      "input": {"$ref": "#/$defs/section"}, "objectives": {"$ref": "#/$defs/section"}, "constraints": {"$ref": "#/$defs/section"}, "interpretation": {"$ref": "#/$defs/section"}
    }},
    "required_extensions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "$defs": {"section": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["id", "value"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "object"}}}}}
}
