{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocp:candidate:core:0.1.0",
  "title": "OCP Core 0.1.0 developer preview",
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "value": {}
      },
      "required": [
        "id",
        "version",
        "required",
        "value"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "weight"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "objectives",
        "constraints",
        "parameters"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "optimized",
            "reported"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "engine",
            "independent"
          ]
        },
        "status": {
          "enum": [
            "evaluated",
            "not_evaluated"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "definition",
        "unit",
        "source",
        "status",
        "value",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "evaluated"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "constraint_evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "enforced",
            "evaluated"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "engine",
            "independent"
          ]
        },
        "status": {
          "enum": [
            "evaluated",
            "not_evaluated"
          ]
        },
        "violation": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "definition",
        "unit",
        "source",
        "status",
        "violation",
        "satisfied",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "evaluated"
              }
            }
          },
          "then": {
            "properties": {
              "violation": {
                "type": "number",
                "minimum": 0
              },
              "satisfied": {
                "type": "boolean"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "violation": {
                "type": "null"
              },
              "satisfied": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "violation": {
                "const": 0
              }
            },
            "required": [
              "violation"
            ]
          },
          "then": {
            "properties": {
              "satisfied": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "violation": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "violation"
            ]
          },
          "then": {
            "properties": {
              "satisfied": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "proof": {
      "type": "object",
      "properties": {
        "claim": {
          "enum": [
            "optimal",
            "infeasible"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "claim",
        "method",
        "scope",
        "evidence"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "implementation": {
          "$ref": "#/$defs/reference"
        },
        "engine": {
          "$ref": "#/$defs/reference"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "implementation",
        "engine",
        "request_id",
        "limitations"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "capability"
        },
        "capability": {
          "$ref": "#/$defs/reference"
        },
        "domain_profile": {
          "$ref": "#/$defs/reference"
        },
        "execution_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              },
              "role": {
                "enum": [
                  "optimized",
                  "reported"
                ]
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "direction",
              "role",
              "definition",
              "unit"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "hard",
                  "soft"
                ]
              },
              "role": {
                "enum": [
                  "enforced",
                  "evaluated"
                ]
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "role",
              "definition",
              "unit"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "configuration_schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "input_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "solution_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "$ref": "#/$defs/configuration"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "capability",
        "domain_profile",
        "execution_profiles",
        "bindings",
        "environments",
        "objectives",
        "constraints",
        "configuration_schema",
        "input_schema_id",
        "solution_schema_id",
        "defaults",
        "limitations"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "request"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/reference"
        },
        "domain_profile": {
          "$ref": "#/$defs/reference"
        },
        "execution_profile": {
          "$ref": "#/$defs/reference"
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "input": {
          "type": "object"
        },
        "budget": {
          "type": "object",
          "properties": {
            "time_limit_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "time_limit_ms"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "request_id",
        "capability",
        "domain_profile",
        "execution_profile",
        "configuration",
        "input",
        "budget"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "requirements"
        },
        "capability": {
          "$ref": "#/$defs/reference"
        },
        "domain_profile": {
          "$ref": "#/$defs/reference"
        },
        "effective_configuration": {
          "$ref": "#/$defs/configuration"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason",
              "unit"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "input_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "capability",
        "domain_profile",
        "effective_configuration",
        "required_fields",
        "input_schema_id"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "validation"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "request_id",
        "valid",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "result"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/reference"
        },
        "domain_profile": {
          "$ref": "#/$defs/reference"
        },
        "execution_profile": {
          "$ref": "#/$defs/reference"
        },
        "effective_configuration": {
          "$ref": "#/$defs/configuration"
        },
        "status": {
          "enum": [
            "feasible",
            "optimal",
            "infeasible",
            "unknown"
          ]
        },
        "termination": {
          "enum": [
            "completed",
            "time_limit",
            "cancelled",
            "search_exhausted"
          ]
        },
        "solution": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_evaluation"
          },
          "minItems": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "request_id",
        "capability",
        "domain_profile",
        "execution_profile",
        "effective_configuration",
        "status",
        "termination",
        "solution",
        "proof",
        "metrics",
        "constraints",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "feasible",
                  "optimal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "solution": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "solution": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "optimal",
                  "infeasible"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "$ref": "#/$defs/proof"
              },
              "termination": {
                "enum": [
                  "completed",
                  "search_exhausted"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "proof": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "optimal"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "properties": {
                  "claim": {
                    "const": "optimal"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "infeasible"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "properties": {
                  "claim": {
                    "const": "infeasible"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "failure"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              },
              "minItems": 0
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "issues"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "evaluation"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/reference"
        },
        "domain_profile": {
          "$ref": "#/$defs/reference"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_evaluation"
          },
          "minItems": 0
        },
        "evaluator": {
          "$ref": "#/$defs/reference"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "minItems": 0
        }
      },
      "required": [
        "core_version",
        "kind",
        "request_id",
        "capability",
        "domain_profile",
        "metrics",
        "constraints",
        "evaluator",
        "limitations"
      ],
      "additionalProperties": false
    },
    "conformance": {
      "type": "object",
      "properties": {
        "core_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "conformance"
        },
        "implementation": {
          "$ref": "#/$defs/reference"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sha256"
          ],
          "additionalProperties": false
        },
        "suite": {
          "$ref": "#/$defs/reference"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_TESTED",
                  "NOT_APPLICABLE"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
