{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocp:candidate:inventory.replenishment:0.1.0:solution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "orders": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "minItems": 1,
            "maxItems": 6
          },
          "ending_inventory": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "minItems": 1,
            "maxItems": 6
          }
        },
        "required": [
          "product_id",
          "orders",
          "ending_inventory"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "required": [
    "plans"
  ]
}
