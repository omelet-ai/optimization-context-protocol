{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocp:candidate:routing.coordinates:0.1.0:input",
  "type": "object",
  "properties": {
    "depot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "location": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -85,
              "maximum": 85
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "location"
      ],
      "additionalProperties": false
    },
    "load_unit": {
      "const": "kg"
    },
    "visits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "demand": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "latitude",
              "longitude"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "demand",
          "location"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": [
          "id",
          "capacity"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 16
    },
    "distance": {
      "const": {
        "model": "haversine",
        "earth_radius_m": 6371000,
        "rounding": "ceil",
        "unit": "meter"
      }
    }
  },
  "required": [
    "depot",
    "load_unit",
    "visits",
    "vehicles",
    "distance"
  ],
  "additionalProperties": false
}
